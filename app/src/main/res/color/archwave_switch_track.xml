<!-- Switch track: light grey when on, dark grey when off, so the two states differ by more than the thumb. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/aw_divider" />
    <item android:state_checked="true" android:color="@color/aw_text_2" />
    <item android:color="#FF4D4D4D" />
</selector>
