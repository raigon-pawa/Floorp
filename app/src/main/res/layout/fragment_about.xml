<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.mozilla.reference.browser.settings.AboutFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_icon_monochrome"
            app:tint="@color/aw_text_1" />

        <TextView
            android:id="@+id/about_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAlignment="center"
            android:textColor="@color/aw_text_1"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/version_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="24dp"
            android:paddingVertical="4dp"
            android:textAlignment="center"
            android:textColor="@color/aw_text_2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/about_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            android:textColor="@color/aw_text_2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/about_source_code"
            style="@style/ArchwaveAboutRow"
            android:text="@string/archwave_about_source_code" />

        <TextView
            android:id="@+id/about_licenses"
            style="@style/ArchwaveAboutRow"
            android:text="@string/archwave_about_licenses" />

        <TextView
            android:id="@+id/about_connections"
            style="@style/ArchwaveAboutRow"
            android:text="@string/archwave_about_connections" />

    </LinearLayout>

</ScrollView>
