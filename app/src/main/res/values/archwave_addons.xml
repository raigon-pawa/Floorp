<resources>
    <!-- Add-ons manager: shown above the list when the recommended extensions could not be downloaded. -->
    <string name="archwave_addons_load_failed">Couldn’t load the recommended extensions.</string>
    <!-- Add-ons manager: shown instead of archwave_addons_load_failed when a custom collection is set and could not be loaded, for example because it does not exist. %1$s is the collection's owner, %2$s its name. -->
    <string name="archwave_addons_custom_collection_failed">Couldn’t load the collection %1$s/%2$s. Check “Custom add-on collection” in Settings, or clear it to see the recommended extensions.</string>
    <!-- Add-ons manager: button next to archwave_addons_load_failed that loads the list again. -->
    <string name="archwave_addons_retry">Retry</string>
    <!-- Add-ons manager: overflow menu item that installs an extension from a .xpi file on the device. -->
    <string name="archwave_addons_install_from_file">Install from file</string>
    <!-- Add-ons manager: shown when no app on the device can pick a file for archwave_addons_install_from_file. -->
    <string name="archwave_addons_no_file_picker">No app on this device can pick a file.</string>
    <!-- Installed add-on details: row that looks for a newer version of the extension now. -->
    <string name="archwave_addons_check_for_updates">Check for updates</string>
    <!-- Installed add-on details: shown while the update check of archwave_addons_check_for_updates runs. -->
    <string name="archwave_addons_checking_for_updates">Checking for updates…</string>
    <!-- Installed add-on details: shown when the update check failed, for example without a connection. -->
    <string name="archwave_addons_update_check_failed">Couldn’t check for updates. Try again later.</string>
    <!-- Installed add-on details: result of archwave_addons_check_for_updates when the engine could not install an update. -->
    <string name="archwave_addons_update_failed">Couldn’t update. If the update needs new permissions, allow them in its notification, or try again later.</string>
    <!-- Dialog after the extensions process crashed repeatedly: button that leaves extensions off for now. -->
    <string name="archwave_addons_keep_extensions_disabled">Keep disabled</string>
    <!-- Developer setting "Custom Add-on collection": explanation above the two fields. -->
    <string name="archwave_addons_custom_collection_message">List the extensions of an addons.mozilla.org collection instead of the recommended ones. Leave both fields empty for the default. Archwave restarts to apply the change.</string>
    <!-- Installed add-on details: title of the confirmation before Remove. %1$s is the extension's name. -->
    <string name="archwave_addons_remove_title">Remove %1$s?</string>
    <!-- Installed add-on details: text of the confirmation before Remove. -->
    <string name="archwave_addons_remove_message">The extension and its settings and data will be deleted.</string>
    <!-- Extension install error: the version named in "… is not compatible with Archwave %3$s." %1$s is the GeckoView version, which extension compatibility is checked against. -->
    <string name="archwave_addons_engine_version">(GeckoView %1$s)</string>
    <!-- Overrides the Android Components text in the add-ons list, whose %3$s is the app version (0.1.0); compatibility is checked against the engine version, so it is left out. %1$s is the extension's name, %2$s the app name. -->
    <string name="mozac_feature_addons_status_incompatible">%1$s is not compatible with the engine of your version of %2$s.</string>
</resources>
