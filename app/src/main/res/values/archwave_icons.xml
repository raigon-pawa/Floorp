<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Overrides browser-icons' Photon palette: the letter tile generated for a site without an icon (home screen
         shortcuts, tabs) is a grey with the white letter, not one of eight saturated colours. -->
    <array name="mozac_browser_icons_photon_palette" tools:ignore="UnusedResources">
        <item>#FF2A2A2A</item>
        <item>#FF333333</item>
        <item>#FF3D3D3D</item>
        <item>#FF474747</item>
    </array>
</resources>
