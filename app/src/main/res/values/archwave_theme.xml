<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The whole palette: black, a few greys, white. Colour only for errors and warnings. -->
    <color name="aw_black">#FF000000</color>
    <color name="aw_surface_1">#FF0D0D0D</color> <!-- bars raised above the page -->
    <color name="aw_surface_2">#FF161616</color> <!-- menus, dialogs, sheets, cards -->
    <color name="aw_surface_3">#FF1F1F1F</color> <!-- URL box, selected rows, snackbars -->
    <color name="aw_divider">#FF2A2A2A</color>
    <color name="aw_text_1">#FFFFFFFF</color>
    <color name="aw_text_2">#FFB3B3B3</color>
    <color name="aw_text_hint">#FF8A8A8A</color>
    <color name="aw_text_disabled">#FF6E6E6E</color> <!-- also outlines -->
    <color name="aw_selection">#59FFFFFF</color> <!-- selected text, inline autocomplete -->
    <color name="aw_error">#FFFF6B6B</color>
    <color name="aw_warning">#FFFFD54F</color>

    <!-- Android Components resources, overridden by name (app resources win the merge). -->
    <color name="mozac_browser_menu2_background" tools:ignore="UnusedResources">@color/aw_surface_2</color>
    <color name="mozac_browser_menu_background" tools:ignore="UnusedResources">@color/aw_surface_2</color>
    <color name="mozac_feature_readerview_text_color" tools:ignore="UnusedResources">@color/aw_text_2</color>
    <color name="mozac_feature_readerview_selected" tools:ignore="UnusedResources">@color/aw_text_1</color>
    <color name="mozac_feature_readerview_text_color_disabled" tools:ignore="UnusedResources">@color/aw_text_disabled</color>
    <color name="mozac_feature_readerview_dark_background" tools:ignore="UnusedResources">@color/aw_surface_3</color>
    <color name="mozac_feature_readerview_light_background" tools:ignore="UnusedResources">#FFEEEEEE</color>
    <color name="mozac_feature_addons_text_color_accent" tools:ignore="UnusedResources">@color/aw_text_1</color>
    <color name="mozac_feature_addons_messagebar_warning_background_color" tools:ignore="UnusedResources">@color/aw_warning</color>
    <color name="mozac_feature_addons_messagebar_error_background_color" tools:ignore="UnusedResources">@color/aw_error</color>
    <color name="mozac_feature_downloads_notification" tools:ignore="UnusedResources">@color/aw_text_2</color>
    <color name="mozac_additional_note_background" tools:ignore="UnusedResources">@color/aw_surface_3</color>
    <color name="mozac_additional_note_text_color" tools:ignore="UnusedResources">@color/aw_text_2</color>
    <color name="mozac_feat_prompt_cancel_save_dialog_text_color" tools:ignore="UnusedResources">@color/aw_text_2</color>
    <color name="mozac_destructive_button_text_color" tools:ignore="UnusedResources">@color/aw_error</color>
    <color name="mozac_feature_qr_scan_success_color" tools:ignore="UnusedResources">@color/aw_text_1</color>

    <!-- Black like the rest of the window, so the status bar area above it matches. -->
    <style name="ArchwaveActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/aw_black</item>
    </style>

    <!-- On and off differ by the track (light or dark grey) as well as the thumb (white or grey). -->
    <style name="ArchwaveSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/archwave_switch_track</item>
    </style>

    <!-- The smallest touch target the app allows. -->
    <dimen name="archwave_min_touch_target">48dp</dimen>

    <!-- AppCompat's overflow button is 40dp wide. -->
    <style name="ArchwaveActionOverflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">@dimen/archwave_min_touch_target</item>
    </style>

    <!-- The time picker tells the selected hour/minute field and AM/PM half apart only by these container roles,
         which the app theme maps to the same grey as the unselected ones. -->
    <style name="ArchwaveTimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimaryContainer">@color/aw_text_1</item>
        <item name="colorOnPrimaryContainer">@color/aw_black</item>
        <item name="colorTertiaryContainer">@color/aw_text_1</item>
        <item name="colorOnTertiaryContainer">@color/aw_black</item>
    </style>

    <!-- Android Components' prompts (add-on permissions, downloads, site permissions) are plain dialogs that paint
         themselves with the activity's window background: black on a black page. The parent is the platform
         default, so only the hairline along their top edge is new. -->
    <style name="ArchwavePanelDialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowContentOverlay">@drawable/archwave_panel_edge</item>
    </style>

    <!-- Theme of the application context, where GeckoView reads the accent it uses in web content: text selection
         and its handles, focus rings, checkboxes. A mid grey shows on white and on black pages. The parent is the
         platform default the application context had before, so nothing else changes for pages. -->
    <style name="ArchwaveEngineColors" parent="android:Theme.DeviceDefault.Light.DarkActionBar">
        <item name="android:colorAccent">@color/aw_text_hint</item>
    </style>

    <!-- The style below replaces the library style of the same name, so the library's own items are copied by hand
         from Android Components 160.0.1: compare them again when that version changes. -->
    <!-- Android Components' bottom sheets (save login, credit card, address): the library style is a light theme. -->
    <style name="MozDialogStyle" parent="ThemeOverlay.Material3.BottomSheetDialog" tools:ignore="UnusedResources">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
