<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The one look of the app: always dark, black and grey. Colours are defined in archwave_theme.xml. -->
    <style name="AppThemeNotActionBar" parent="Theme.Material3.Dark.NoActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <!-- Material 3 colour roles. Filled controls are white, so everything "on" them is black. -->
        <item name="colorPrimary">@color/aw_text_1</item>
        <item name="colorOnPrimary">@color/aw_black</item>
        <item name="colorPrimaryContainer">@color/aw_surface_3</item>
        <item name="colorOnPrimaryContainer">@color/aw_text_1</item>
        <item name="colorPrimaryInverse">@color/aw_text_1</item>
        <item name="colorSecondary">@color/aw_text_1</item>
        <item name="colorOnSecondary">@color/aw_black</item>
        <item name="colorSecondaryContainer">@color/aw_surface_3</item>
        <item name="colorOnSecondaryContainer">@color/aw_text_1</item>
        <item name="colorTertiary">@color/aw_text_2</item>
        <item name="colorOnTertiary">@color/aw_black</item>
        <item name="colorTertiaryContainer">@color/aw_surface_3</item>
        <item name="colorOnTertiaryContainer">@color/aw_text_1</item>
        <item name="android:colorBackground">@color/aw_black</item>
        <item name="colorOnBackground">@color/aw_text_1</item>
        <item name="colorSurface">@color/aw_black</item>
        <item name="colorOnSurface">@color/aw_text_1</item>
        <item name="colorSurfaceVariant">@color/aw_surface_3</item>
        <item name="colorOnSurfaceVariant">@color/aw_text_2</item>
        <item name="colorSurfaceDim">@color/aw_black</item>
        <item name="colorSurfaceBright">@color/aw_surface_3</item>
        <item name="colorSurfaceContainerLowest">@color/aw_black</item>
        <item name="colorSurfaceContainerLow">@color/aw_surface_1</item>
        <item name="colorSurfaceContainer">@color/aw_surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/aw_surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/aw_surface_3</item>
        <!-- Snackbars use the inverse roles; keep them dark like every other raised surface. -->
        <item name="colorSurfaceInverse">@color/aw_surface_3</item>
        <item name="colorOnSurfaceInverse">@color/aw_text_1</item>
        <item name="colorOutline">@color/aw_text_disabled</item>
        <item name="colorOutlineVariant">@color/aw_divider</item>
        <item name="colorError">@color/aw_error</item>
        <item name="colorOnError">@color/aw_black</item>
        <item name="colorErrorContainer">@color/aw_surface_3</item>
        <item name="colorOnErrorContainer">@color/aw_error</item>
        <!-- Surfaces keep their exact grey instead of being lightened by elevation. -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- AppCompat and platform colours. Material 3 hard-wires its purple-tinted defaults into the text colours. -->
        <item name="colorPrimaryDark">@color/aw_black</item>
        <item name="colorAccent">@color/aw_text_1</item>
        <item name="colorControlActivated">@color/aw_text_1</item>
        <item name="colorControlNormal">@color/aw_text_2</item>
        <item name="colorSwitchThumbNormal">@color/aw_text_2</item>
        <item name="colorBackgroundFloating">@color/aw_surface_2</item>
        <item name="android:textColorPrimary">@color/archwave_text_primary</item>
        <item name="android:textColorSecondary">@color/archwave_text_secondary</item>
        <item name="android:textColorTertiary">@color/archwave_text_secondary</item>
        <item name="android:textColorHint">@color/aw_text_hint</item>
        <item name="android:textColorHighlight">@color/aw_selection</item>
        <item name="android:textColorLink">@color/aw_text_1</item>
        <item name="android:textColorAlertDialogListItem">@color/aw_text_1</item>
        <!-- Android Components' prompts fill their buttons with this colour and put white text on it. -->
        <item name="android:colorEdgeEffect">@color/aw_text_disabled</item>
        <!-- The system bars are transparent (edge-to-edge), so this is also what shows behind them. -->
        <item name="android:windowBackground">@color/aw_black</item>
        <item name="android:navigationBarColor">@color/aw_black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <!-- The Material 3 switch has a white thumb both on and off; the AppCompat one dims it when off. -->
        <item name="switchStyle">@style/Widget.AppCompat.CompoundButton.Switch</item>
        <item name="actionBarStyle">@style/ArchwaveActionBar</item>
        <item name="actionOverflowButtonStyle">@style/ArchwaveActionOverflow</item>
        <item name="materialTimePickerTheme">@style/ArchwaveTimePicker</item>
        <item name="android:dialogTheme">@style/ArchwavePanelDialog</item>

        <!-- Theme attributes that Android Components layouts and drawables read. -->
        <item name="mozac_primary_text_color">@color/aw_text_1</item>
        <item name="mozac_caption_text_color">@color/aw_text_2</item>
        <item name="mozac_accent">@color/aw_text_1</item>
        <item name="mozac_contrast_text">@color/aw_black</item>
        <item name="mozac_widget_favicon_background_color">@color/aw_surface_2</item>
        <item name="mozac_widget_favicon_border_color">@color/aw_divider</item>
        <item name="mozacPromptLoginEditTextCursorColor">@color/aw_text_1</item>
    </style>

    <style name="AppTheme" parent="AppThemeNotActionBar">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <style name="AddonsActivityTheme" parent="AppTheme">
        <!-- In the add-ons manager this colour is only used for text on the amber and red message bars. -->
        <item name="mozac_primary_text_color">@color/aw_black</item>
    </style>
</resources>
